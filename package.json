{
  "name": "vibe-pad",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npx vite",
    "electron": "npx vite build && npx electron .",
    "build": "npx vite build",
    "build:exe": "npx vite build && node scripts/build-exe.js",
    "register": "node scripts/register-windows.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.vibepad.app",
    "productName": "VibePad",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "public/vibe-icon.svg"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/language": "^6.10.2",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.29.1",
    "@neutralinojs/lib": "^6.9.0",
    "@webviewjs/webview": "^0.2.1",
    "clsx": "^2.1.1",
    "diff": "^5.2.0",
    "highlight.js": "^11.9.0",
    "iconv-lite": "^0.6.3",
    "katex": "^0.16.11",
    "lucide-react": "^0.424.0",
    "markdown-it": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/diff": "^5.2.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
